{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "greenish_blue": "#31748f",
    "lavender": "#c4a7e7",
    "light_blue": "#9ccfd8",
    "light_gray": "#6e6a86",
    "peach": "#ebbcba",
    "red": "#eb6f92",
    "white": "#e0def4",
    "yellow": "#f6c177"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none",
            "folder_separator_icon": "/",
            "mapped_locations": {
              "~": ""
            },
            "style": "full"
          },
          "template": "{{ .Path }} ",
          "foreground": "p:lavender",
          "type": "path",
          "style": "plain"
        },
        {
          "properties": {
            "branch_icon": "git:",
            "cache_duration": "none",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": "{{ .HEAD }}{{ if .Staging.Changed }} {{ .Staging.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Working.Changed }} {{ .Working.String }}{{ end }}",
          "foreground": "p:light_gray",
          "type": "git",
          "style": "plain",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:peach{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:red{{ end }}",
            "{{ if gt .Ahead 0 }}p:red{{ end }}",
            "{{ if gt .Behind 0 }}p:red{{ end }}"
          ]
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": "\uf105",
          "foreground": "p:light_blue",
          "type": "text",
          "style": "plain"
        }
      ],
      "newline": true
    },
    {
      "type": "rprompt",
      "alignment": "right",
      "segments": [
        {
          "properties": {
            "cache_duration": "none"
          },
          "template": " {{ .UserName }}@{{ .HostName }} ",
          "foreground": "p:light_gray",
          "type": "session",
          "style": "plain"
        }
      ]
    }
  ],
  "version": 3,
  "final_space": true
}
