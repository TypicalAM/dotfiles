export ZSH="$HOME/.oh-my-zsh"
#ZSH_THEME='cloud'
#ZSH_THEME="blinks"
#ZSH_THEME="af-magic"
#ZSH_THEME="robbyrussell"
#ZSH_THEME="agnoster"
COMPLETION_WAITING_DOTS="true"
HIST_STAMPS="mm/dd/yyyy"
HISTSIZE=10000000
SAVEHIST=10000000

# compaudit stats every fpath directory on every start to warn about
# group-writable completion dirs. Nothing here is group-writable.
ZSH_DISABLE_COMPFIX=true

plugins=(
	poetry
	git
	zsh-autosuggestions
)

zstyle ':omz:update' mode disabled
source $ZSH/custom/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
source $ZSH/oh-my-zsh.sh
autoload zmv

# User specific aliases and functions
if [ -d ~/.bashrc.d ]; then
	for rc in ~/.bashrc.d/*; do
		. "$rc"
	done
fi

# --- WezTerm shell integration: make the per-prompt hooks fork-free --------
# wezterm.sh re-encodes the same four user vars on every prompt, forking
# base64 four times plus id and a cat. None of those values change inside a
# shell, so build the escape sequence once and cache it across shells.
() {
	local cache=$HOME/.cache/zsh/wezterm-uservars-$HOST
	if [[ ! -s $cache ]]; then
		mkdir -p $HOME/.cache/zsh
		{
			printf '\033]1337;SetUserVar=WEZTERM_PROG=\007'
			printf '\033]1337;SetUserVar=WEZTERM_USER=%s\007' "$(print -n -- ${USER:-$(id -un)} | base64)"
			printf '\033]1337;SetUserVar=WEZTERM_HOST=%s\007' "$(print -n -- "$(</proc/sys/kernel/hostname)" | base64)"
		} >| $cache
	fi
	typeset -g __WEZTERM_USER_VARS="$(<$cache)"
	# base64 of "0" and "1"; the only per-shell value is tmux membership.
	typeset -g __WEZTERM_TMUX_VAR=$'\033]1337;SetUserVar=WEZTERM_IN_TMUX='${${TMUX:+MQ==}:-MA==}$'\007'
}
__wezterm_user_vars_precmd() {
	printf '%s%s' "$__WEZTERM_USER_VARS" "$__WEZTERM_TMUX_VAR"
}

# wezterm.sh already reports the cwd via OSC 7 (__wezterm_osc7); oh-my-zsh's
# omz_termsupport_cwd emits the identical sequence a second time.
precmd_functions=(${precmd_functions:#omz_termsupport_cwd})

# --- distrobox / prompt ----------------------------------------------------
# base64 of the JSON jq would emit for the common "not in a container" case,
# so the usual path does not fork jq and base64.
__wezterm-set-distrobox() {
	local args
	if [[ $1 == none ]]; then
		args='ewogICJjb250YWluZXIiOiAibm9uZSIKfQo='
	else
		args=$(jq -n --arg container "$1" '{"container":$container}' | base64)
	fi
	printf "\033]1337;SetUserVar=%s=%s\007" "is-distrobox" $args
}

if [ -f /run/.toolboxenv -o -f /run/.containerenv ]; then
	local name
	export IS_CONTAINER=1
	name=$(grep '^name=' /run/.containerenv | cut -d= -f2 | tr -d '"')
	__wezterm-set-distrobox "$name"
	__OMP_THEME=$HOME/.config/ohmyposh/my_custom_container_theme.json
else
	export IS_CONTAINER=0
	__wezterm-set-distrobox "none"
	__OMP_THEME=$HOME/.config/ohmyposh/my_custom_rose_theme.json
fi

# `oh-my-posh init` must actually run: it writes the resolved theme into a
# per-session cache that `oh-my-posh print primary` reads back. Sourcing the
# generated init file directly skips that step, and the prompt silently falls
# back to the default theme.
eval "$(oh-my-posh init zsh --config $__OMP_THEME)"

# fzf --zsh prints ~650 fixed lines; cache them rather than forking fzf.
() {
	local f=$HOME/.cache/zsh/fzf.zsh
	if [[ ! -s $f || ${commands[fzf]} -nt $f ]]; then
		mkdir -p $HOME/.cache/zsh
		fzf --zsh >| $f
	fi
	source $f
}

# Refresh the cached /etc environment in the background when it went stale.
if [[ -z $__SYSENV_REPLAYED && -x $HOME/.config/zsh/gen-sysenv.zsh ]]; then
	($HOME/.config/zsh/gen-sysenv.zsh $HOME/.cache/zsh/system-env.zsh >/dev/null 2>&1 &)
fi
